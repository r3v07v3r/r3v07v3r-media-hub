{
  "name": "r3v07v3r-media-hub",
  "version": "1.0.83",
  "description": "Standalone TorBox-powered Movies, Series and Anime desktop client",
  "main": "./out/main/index.js",
  "author": "R3v07v3R",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "tsx tests/unsafeFiles.test.ts && tsx tests/language.test.ts && tsx tests/streamSelection.test.ts && tsx tests/floatingPanel.test.ts && tsx tests/playbackPreparation.test.ts && tsx tests/animeCatalogStorage.test.ts && tsx tests/databasePruning.test.ts && tsx tests/anilist.test.ts && tsx tests/playbackPosition.test.ts && tsx tests/partySync.test.ts && tsx tests/streamCache.test.ts && tsx tests/subdl.test.ts && tsx tests/mpvTracks.test.ts && tsx tests/videoFit.test.ts && tsx tests/reconcileSync.test.ts && tsx tests/ollama.test.ts",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "postinstall": "electron-builder install-app-deps && tsx scripts/fetch-mpv.ts",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win",
    "build:mac": "electron-vite build && electron-builder --mac",
    "build:linux": "electron-vite build && electron-builder --linux",
    "ai:qa": "tsx scripts/ai-qa.ts",
    "ai:screenshot": "tsx scripts/ai-screenshots.ts",
    "ai:review": "tsx scripts/ai-review.ts",
    "ai:loop": "tsx scripts/ai-loop.ts"
  },
  "dependencies": {
    "@achingbrain/nat-port-mapper": "^4.0.5",
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/rajdhani": "^5.3.0",
    "default-gateway": "^7.2.2",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9",
    "framer-motion": "^12.42.2",
    "react-router-dom": "^7.18.1",
    "systeminformation": "^5.33.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config-prettier": "^3.0.0",
    "@electron-toolkit/eslint-config-ts": "^3.1.0",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "playwright": "^1.62.0",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sass": "^1.102.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.6",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
